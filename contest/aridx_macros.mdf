/$ 34 


//
// Macro # 36
/$ 35 RTTY
<MODEM:RTTY:170:45.45:5>\n
<RIGMODE:USB-D>\n


//
// Macro # 37
/$ 36 Hell CQ+
<TX>CQ CQ CQ DE <MYCALL> <MYCALL> <MYCALL> K\n
<RX>\n
<AFTER:20>

//
// Macro # 38
/$ 37 Hell Ans
<TX>\n
<CALL> <CALL> de <MYCALL> <MYCALL> <MYCALL> KN\n
<RX>

//
// Macro # 39
/$ 38 Hell QSO >>
<TX><IDLE:1>\n
\n
<CALL> de <MYCALL> 

//
// Macro # 40
/$ 39 Hell KN ||
<CALL> DE <MYCALL> KN\n
<RX>

//
// Macro # 41
/$ 40 Hell SK ||
\n
TNX GL 73 73  <CALL> DE <MYCALL> SK\n
<RX>

