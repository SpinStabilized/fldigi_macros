//fldigi macro definition file extended
// This file defines the macro structure(s) for the digital modem program, fldigi
// It also serves as a basis for any macros that are written by the user
//
// The top line of this file should always be the first line in every macro 
// definition file (.mdf) for the fldigi program to recognize it as such.
//

//
// Macro # 1
/$ 0 CQ+
<TX>\n
<IDLE:0.5>\n
CQ CQ CQ de <MYCALL> <MYCALL>\n
CQ CQ CQ de <MYCALL> <MYCALL> PSE K\n
<RX><AFTER:20>

//
// Macro # 2
/$ 1 ANS @>|
<TX><IDLE:1>\n
\n
<CALL> <CALL> de <MYCALL> <MYCALL> <MYCALL> KN\n
<IDLE:1>\n
<RX>

//
// Macro # 3
/$ 2 QSO @>>
<TX><IDLE:1>\n
\n
<CALL> de <MYCALL> 

//
// Macro # 4
/$ 3 KN @||
 <CALL> de <MYCALL> kn\n
<RX>

//
// Macro # 5
/$ 4 SK @||
\n
tnx fer QSO 73 73  <CALL> de <MYCALL> sk\n
<RX>

//
// Macro # 6
/$ 5 Me/Qth
<MYNAME> <MYQTH> <MYST> <MYLOC>\n


//
// Macro # 7
/$ 6 Brag
\n
<MYCALL> NAME IS <MYNAME> IC-7300 ON EFHW\n
\n


//
// Macro # 8
/$ 7 


//
// Macro # 9
/$ 8 T/R
<TX/RX>

//
// Macro # 10
/$ 9 Tx @>>
<TX><IDLE:1>

//
// Macro # 11
/$ 10 Rx @||
<RX>

//
// Macro # 12
/$ 11 TX @>|
<TX>\n
de <MYCALL> k\n
<RX>

//
// Macro # 13
/$ 12 CQ ARIDX
<TX><IDLE:1>\n
CQ CQ CQ ARIDX TEST DE <MYCALL> <MYCALL> K\n
<IDLE:1><RX><AFTER:20>

//
// Macro # 14
/$ 13 CQ ANSWER
<TX><IDLE:1>\n
<CALL> <RST> <RST> <CNTR> <CNTR>  DE <MYCALL> KN\n
<IDLE:1><RX>

//
// Macro # 15
/$ 14 C Ans @>|
<TX><IDLE:1>\n
<MYCALL> <MYCALL> \n
<IDLE:1><RX>

//
// Macro # 16
/$ 15 C Rep @>|
<TX><IDLE:1>\n
<CALL> RR <RST> <RST> <CNTR> <CNTR> GL 73 DE <MYCALL> K\n
<IDLE:1><RX>

//
// Macro # 17
/$ 16 C Incr
<INCR>

//
// Macro # 18
/$ 17 C Decr
<DECR>

//
// Macro # 19
/$ 18 Log QSO
<LOG><INCR>

//
// Macro # 20
/$ 19 AGN?
<TX><IDLE:0.5>\n
AGN? AGN?\n
<IDLE:0.5>\n
<RX>

//
// Macro # 21
/$ 20 


//
// Macro # 22
/$ 21 


//
// Macro # 23
/$ 22 


//
// Macro # 24
/$ 23 


//
// Macro # 25
/$ 24 


//
// Macro # 26
/$ 25 CQ TU
<TX><IDLE:1>\n
<CALL> TU GL 73 DE <MYCALL>\n
<IDLE:1><RX>

//
// Macro # 27
/$ 26 Rep @>|
<TX><IDLE:1>\n
<CALL> UR <RST> <RST> <CNTR> <CNTR> DE <MYCALL> KN\n
<IDLE:1><RX>

