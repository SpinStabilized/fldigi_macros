// Row 1 ----------------------------------------------------------------------- 
//
// Macro # 1
/$ 0 CQ @#+
<TX><IDLE:1>\n
CQ SCRY <MYCALL> TEST CQ\n
<IDLE:0.5><RX><AFTER:15>

//
// Macro # 2
/$ 1 Resp @>|
<TX><IDLE:1>\n
<CALL> <XBEG>599 2025<XEND> 2025 <MYCALL> \n
<IDLE:0.5><RX>

//
// Macro # 3
/$ 2 Run @>|
<TX><IDLE:1>\n
<CALL> TU <MYCALL> QRZ? \n
<IDLE:0.5><RX>

//
// Macro # 4
/$ 3 Stop @>|
<TX><IDLE:1>\n
<CALL> TU <MYCALL>\n
<IDLE:0.5><RX>

//
// Macro # 5
/$ 4 QRT @>|
<TX><IDLE:1>\n
DE <MYCALL> QRT QRT DE <MYCALL> SK \n
<IDLE:0.5>RX

//
// Macro # 6
/$ 5  Log
<LOG><CLRLOG>


//
// Macro # 7
/$ 6 


//
// Macro # 8
/$ 7 


//
// Macro # 9
/$ 8 T/R
<TX/RX>

//
// Macro # 10
/$ 9 Tx @>>
<TX><IDLE:1>

//
// Macro # 11
/$ 10 Rx @||
<IDLE:0.5><RX>

//
// Macro # 12
/$ 11 TX @>|
<TX>\n
<MYCALL> k\n
<IDLE:0.5><RX>

