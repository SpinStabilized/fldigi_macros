//fldigi macro definition file extended
// =============================================================================
// Description: Contest macros for Feld Hell Club Sprints
// General Sprint Rules: https://sites.google.com/site/feldhellclub/Home/contests/sprint-rules
// WAA Sprint Rules:     https://sites.google.com/site/feldhellclub/Home/contests/sprints/worked-all-americas-sprint
//
// EXCHANGE = FH #, STATE/PROVINCE/COUNTRY, GRID   (no RST is sent)
// =============================================================================

// Row 1 -----------------------------------------------------------------------
//
// Macro # 1
/$ 0 CQ @#+
<TX>CQ CQ CQ FH TEST DE <MYCALL> <MYCALL> PSE K<RX><AFTER:30>

//
// Macro # 2
/$ 1 Exch @>|
<TX><CALL> <XBEG>#7976 MD FM19<XEND> de <MYCALL> KN<RX>

//
// Macro # 3
/$ 2 Run @>|
<TX> <CALL> TU <MYCALL> QRZ? K <RX>

//
// Macro # 4
/$ 3 Stop @>|
<TX> <CALL> TU <MYCALL> <RX>

//
// Macro # 5
/$ 4 QRT @>|
<TX>DE <MYCALL> QRT QRT DE <MYCALL> SK<RX>

//
// Macro # 6
/$ 5 Log
<LOG><CLRLOG>

//
// Macro # 7
/$ 6 

//
// Macro # 8
/$ 7 

//
// Macro # 9
/$ 8 

//
// Macro # 10
/$ 9 

//
// Macro # 11
/$ 10 Tx @>>
<TX>

//
// Macro # 12
/$ 11 Rx @||
<RX>

// Row 2 - Search & Pounce -------------------------------------------------------
//
// Macro # 13
/$ 12 SP Hunt @>|
<TX><CALL> DE <MYCALL> <MYCALL> <RX>

//
// Macro # 14
/$ 13 SP Ans @>|
<TX><CALL> #7976 #7976 MD MD FM19 FM19 de <MYCALL> KN<RX>

//
// Macro # 15
/$ 14 My Call @>|
<TX><MYCALL> <MYCALL><RX>

//
// Macro # 16
/$ 15 My FH# @>|
<TX><CALL> #7976 #7976 de <MYCALL><RX>

//
// Macro # 17
/$ 16 My QTH @>|
<TX><CALL> MD MD de <MYCALL><RX>

//
// Macro # 18
/$ 17 My Grid @>|
<TX><CALL> FM19 FM19 de <MYCALL><RX>

//
// Macro # 19
/$ 18 

//
// Macro # 20
/$ 19 

//
// Macro # 21
/$ 20 

//
// Macro # 22
/$ 21 

//
// Macro # 23
/$ 22 

//
// Macro # 24
/$ 23 

// Row 3 - Fills / Repeats ---------------------------------------------------
//
// Macro # 25
/$ 24 AGN? @>|
<TX>AGN?<RX>

//
// Macro # 26
/$ 25 

//
// Macro # 27
/$ 26 Call AGN? @>|
<TX><CALL> CALL AGN? de <MYCALL><RX>

//
// Macro # 28
/$ 27 FH# AGN? @>|
<TX><CALL> FH AGN? de <MYCALL><RX>

//
// Macro # 29
/$ 28 QTH AGN? @>|
<TX><CALL> QTH AGN? de <MYCALL><RX>

//
// Macro # 30
/$ 29 Grid AGN? @>|
<TX><CALL> GRID AGN? de <MYCALL><RX>

//
// Macro # 31
/$ 30 

//
// Macro # 32
/$ 31 

//
// Macro # 33
/$ 32 Feld Hell
<MODEM:FELDHELL>\n
<RIGMODE:USB-D>\n
<RXRSID:off>\n
<TXRSID:off>

//
// Macro # 34
/$ 33 Olivia 8-250
<MODEM:OLIVIA:250:8>\n
<RIGMODE:USB-D>\n
<MACROS:/Users/brian/.fldigi/macros/olivia_macros.mdf>\n
<RXRSID:on>\n
<TXRSID:on>

//
// Macro # 35
/$ 34 PSK
<MODEM:BPSK31>\n
<RIGMODE:USB-D>\n
<MACROS:/Users/brian/.fldigi/macros/psk_macros.mdf>\n
<RXRSID:off>\n
<TXRSID:off>

//
// Macro # 36
/$ 35 RTTY
<MODEM:RTTY:170:45.45:5>\n
<RIGMODE:USB-D>\n
<MACROS:/Users/brian/.fldigi/macros/rtty_macros.mdf>\n
<RXRSID:off>\n
<TXRSID:off>

// Row 4 - Utility -------------------------------------------------------------
//
// Macro # 37
/$ 36 QSO @>>
<TX>\n
<CALL> de <MYCALL> 

//
// Macro # 38
/$ 37 KN @||
<CALL> DE <MYCALL> KN
<RX>

//
// Macro # 39
/$ 38 SK @||
TNX GL 73 73  <CALL> DE <MYCALL> SK
<RX>

//
// Macro # 40
/$ 39 Me/Qth
<MYNAME> <MYQTH> <MYST> <MYLOC> #7976

//
// Macro # 41
/$ 40 Brag
<MYCALL> NAME IS <MYNAME> IC-7300 @ <TX_PWR> ON <ANTENNA>

//
// Macro # 42
/$ 41 

//
// Macro # 43
/$ 42 

//
// Macro # 44
/$ 43 

//
// Macro # 45
/$ 44 Entry to QRZ
<EXEC>/opt/homebrew/bin/uv run --directory $HOME/source/fldigi_to_qrz/ python fldigi_to_qrz.py</EXEC>

//
// Macro # 46
/$ 45 CLR Tx
<CLRTX>

//
// Macro # 47
/$ 46 CLR Rx
<CLRRX>

//
// Macro # 48
/$ 47 CLRALL
<CLRRX><CLRTX>
