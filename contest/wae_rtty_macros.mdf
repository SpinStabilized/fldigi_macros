//fldigi macro definition file extended
// =============================================================================
// Description: Contest macros for DARC Worked All Europe (WAE), RTTY
// WAEDC Rules: https://www.darc.de/der-club/referate/conteste/wae-dx-contest/en/wae-rules/
//
// EXCHANGE = RST SERIAL
//
// Brian McLaughlin (N3BMC) <n3bmc@arrl.net>
//
// History:
// Date       Initials Notes
// ---------- -------- ---------------------------------------------------------
// 2026-11-13 BMC      Created from the JARL WW RTTY macros written for 2026
//
// =============================================================================

// Row 1 -----------------------------------------------------------------------
//
// Macro # 1
/$ 0 CQ @#+
<TX>\n
CQ CQ WAE <MYCALL> <MYCALL> CQ \n
<RX><AFTER:10>

//
// Macro # 2
/$ 1 Resp @>|
<TX>\n
<CALL> 599 <CNTR> <CNTR> <MYCALL> \n
<RX>

//
// Macro # 3
/$ 2 Run @>|
<TX>\n
<CALL> TU GL <MYCALL> CQ\n
<RX>

//
// Macro # 4
/$ 3 Stop @>|
<TX>\n
<CALL> TU <MYCALL>\n
<RX>

//
// Macro # 5
/$ 4 QRT @>|
<TX>\n
DE <MYCALL> QRT QRT DE <MYCALL> SK \n
<RX>

//
// Macro # 6
/$ 5  Log
<LOG><EXEC>fltools clublog</EXEC><INCR>

//
// Macro # 7
/$ 6 TU QTC? @>|
<TX>\n
<CALL> TU QTC? <MYCALL>\n
<RX>

//
// Macro # 8
/$ 7 

//
// Macro # 9
/$ 8 

//
// Macro # 10
/$ 9 

//
// Macro # 11
/$ 10 Tx @>>
<TX>\n

//
// Macro # 12
/$ 11 Rx @||
\n
<RX>

// Row 2 -----------------------------------------------------------------------
//
// Macro # 13
/$ 12 SP Hunt @>|
<TX>\n
<MYCALL> <MYCALL> \n
<RX>

//
// Macro # 14
/$ 13 SP Ans @>|
<TX>\n
<CALL> TU 599 <CNTR> <CNTR> <MYCALL>\n
<RX>

//
// Macro # 15
/$ 14 SP Ans QTC? @>|
<TX>\n
<CALL> TU 599 <CNTR> <CNTR> QTC? <MYCALL>\n
<RX>

//
// Macro # 16
/$ 15 QTC Send @>|
<TX>\n
<CALL> DE <MYCALL> \n
 <EXEC>cat "$HOME/.fldigi/qtc/qtc_send.txt"</EXEC>
END QTC <CALL> QSL? <MYCALL> \n
<RX>

//
// Macro # 17
/$ 16 QTC TU @>|
<TX>\n
<CALL> TU QSL QTC GL <MYCALL>\n
<RX>

//
// Macro # 18
/$ 17 QTC QRV @>|
<TX>\n
<CALL> QRV QTC <MYCALL>\n
<RX>

//
// Macro # 19
/$ 18 QSL ALL @>|
<TX>\n
<CALL> QSL ALL QTC TU <MYCALL>\n
<RX>

//
// Macro # 20
/$ 19 QTC AGN @>>
<TX>\n
<CALL> AGN QTC NR 

//
// Macro # 21
/$ 20 No QTC @>|
<TX>\n
<CALL> SRI NO QTC TU <MYCALL>\n
<RX>

//
// Macro # 22
/$ 21 

//
// Macro # 23
/$ 22 QTC Edit
<EXEC>/usr/local/bin/code "$HOME/.fldigi/qtc/qtc_send.txt" >/dev/null 2>&1 &</EXEC>

//
// Macro # 24
/$ 23 

// Row 3 -----------------------------------------------------------------------
//
// Macro # 25
/$ 24 Full Repeat @>|
<TX>\n
<CALL> 599 <CNTR> <CNTR> <MYCALL> \n
<RX>

//
// Macro # 26
/$ 25 RST Repeat @>|
<TX>\n
 599 599 \n
<RX>

//
// Macro # 27
/$ 26 NR Repeat @>|
<TX>\n
 <CNTR> <CNTR> \n
<RX>

//
// Macro # 28
/$ 27 

//
// Macro # 29
/$ 28 

//
// Macro # 30
/$ 29 

//
// Macro # 31
/$ 30 

//
// Macro # 32
/$ 31 

//
// Macro # 33
/$ 32 Feld Hell
<MODEM:FELDHELL>
<RIGMODE:USB-D>
<RXRSID:off>
<TXRSID:off>
<MACROS:/Users/brian/.fldigi/macros/hell_macros.mdf>

//
// Macro # 34
/$ 33 Olivia 8-250
<MODEM:OLIVIA:250:8>
<RIGMODE:USB-D>
<RXRSID:on>
<TXRSID:on>
<MACROS:/Users/brian/.fldigi/macros/olivia_macros.mdf>

//
// Macro # 35
/$ 34 PSK
<MODEM:BPSK31>
<RIGMODE:USB-D>
<RXRSID:on>
<TXRSID:on>
<MACROS:/Users/brian/.fldigi/macros/psk_macros.mdf>

//
// Macro # 36
/$ 35 RTTY
<MODEM:RTTY:170:45.45:5>
<RIGMODE:RTTY>
<RXRSID:off>
<TXRSID:off>
<MACROS:/Users/brian/.fldigi/macros/rtty_macros.mdf>

// Row 4 -----------------------------------------------------------------------
//
// Macro # 37
/$ 36 AGN? @>|
<TX>\n
AGN AGN? \n
<RX>

//
// Macro # 38
/$ 37 RST? @>|
<TX>\n
RST RST? \n
<RX>

//
// Macro # 39
/$ 38 NR? @>|
<TX>\n
NR NR? \n
<RX>

//
// Macro # 40
/$ 39 CALL? @>|
<TX>\n
CALL CALL? \n
<RX>

//
// Macro # 41
/$ 40 QTC? @>|
<TX>\n
<CALL> QTC? <MYCALL>\n
<RX>

//
// Macro # 42
/$ 41 

//
// Macro # 43
/$ 42 fltools Log
<EXEC>open -a Console "$HOME/Library/Logs/fltools/fltools.log" >/dev/null 2>&1 &</EXEC>

//
// Macro # 44
/$ 43 Entry to ClubLog
<EXEC>fltools clublog</EXEC>

//
// Macro # 45
/$ 44 Entry to QRZ
<EXEC>fltools qrz</EXEC>

//
// Macro # 46
/$ 45 CLR Tx
<CLRTX>

//
// Macro # 47
/$ 46 CLR Rx
<CLRRX>

//
// Macro # 48
/$ 47 CLRALL
<CLRRX><CLRTX>
