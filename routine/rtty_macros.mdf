// Macro # 33
/$ 32 Feld Hell
<MODEM:FELDHELL>
<RIGMODE:USB-D>
<RXRSID:off>
<TXRSID:off>
<MACROS:/Users/brian/.fldigi/macros/hell_macros.mdf>


//
// Macro # 34
/$ 33 Olivia 8-250
<MODEM:OLIVIA:250:8>
<RIGMODE:USB-D>
<RXRSID:on>
<TXRSID:on>
<MACROS:/Users/brian/.fldigi/macros/olivia_macros.mdf>


//
// Macro # 35
/$ 34 PSK
<MODEM:BPSK31>
<RIGMODE:USB-D>
<RXRSID:off>
<TXRSID:off>
<MACROS:/Users/brian/.fldigi/macros/psk_macros.mdf>


//
// Macro # 36
/$ 35 RTTY
